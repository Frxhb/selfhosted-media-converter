# Initial defaults; UI-saved settings take precedence after the first save.
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_PER_DOMAIN=2
MAX_CONCURRENT_WHISPER_JOBS=1
# Auto divides the affinity/cgroup-aware CPU budget by MAX_CONCURRENT_JOBS.
FFMPEG_THREADS=Auto
DEFAULT_PRIORITY=below_normal
MIN_FREE_DISK_GB=2.0
AUTO_DELETE_ORIGINALS=false
AUTO_CLEANUP_DAYS=0
LOG_LEVEL=INFO
