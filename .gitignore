# Media contents (ignore downloaded/processed files, keep empty directories)
media/inputs/*
media/outputs/*

# Database, runtime configs, and backups
config/*

# Python cache and environments
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Environment files and secrets
.env
.env.*
!.env.example
*.db
# test docker yml
docker-compose.override.yml

# System / Editor junk
.DS_Store
.vscode/
.idea/
*.log
